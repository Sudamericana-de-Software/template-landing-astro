---
import Cards from "./Cards.astro";
import Intro from "./Intro.astro";
import Outro from "./Outro.astro";

const introText = "We design spaces that don’t just exist.";
const outroText = "Architecture reimagined for the virtual age.";

const cards = [
  {
    title: "Curved Horizon",
    description:
      "A futuristic residence that plays with curvature and flow, blending bold geometry with natural topography.",
    imageSrc: "https://images.pexels.com/photos/32542762/pexels-photo-32542762.jpeg?_gl=1*19b8gxt*_ga*MTQ4NDYwMzY2Mi4xNzQ3MDc5MjQ1*_ga_8JE65Q40S6*czE3NTEzODE2NTIkbzExJGcxJHQxNzUxMzgxNjcxJGo0MSRsMCRoMA..",
    marquee: [
      "Design Beyond Boundaries",
      "Built for Tomorrow",
      "Real Impact",
      "Digital Visions",
    ],
  },
  {
    title: "Glass Haven",
    description:
      "A sleek pavilion of pure transparency, openness and light, designed to dissolve into its environment.",
    imageSrc: "https://images.pexels.com/photos/13612713/pexels-photo-13612713.jpeg?_gl=1*187ioa5*_ga*MTQ4NDYwMzY2Mi4xNzQ3MDc5MjQ1*_ga_8JE65Q40S6*czE3NTEzODE2NTIkbzExJGcxJHQxNzUxMzgxNzk3JGo1OSRsMCRoMA..",
  },
  {
    title: "Moss Cube",
    description:
      "A minimalist cube home crowned with a living moss dome, merging micro-architecture with ecological design.",
    imageSrc: "https://images.pexels.com/photos/29877588/pexels-photo-29877588.jpeg?_gl=1*bsexnl*_ga*MTQ4NDYwMzY2Mi4xNzQ3MDc5MjQ1*_ga_8JE65Q40S6*czE3NTEzODE2NTIkbzExJGcxJHQxNzUxMzgxODQyJGoxNCRsMCRoMA..",
  },
  {
    title: "Floating Shelter",
    description:
      "This design explores an ethereal structure perched on a grassy islet, seemingly hovering above water.",
    imageSrc: "https://images.pexels.com/photos/29877599/pexels-photo-29877599.jpeg?_gl=1*1xffxdb*_ga*MTQ4NDYwMzY2Mi4xNzQ3MDc5MjQ1*_ga_8JE65Q40S6*czE3NTEzODE2NTIkbzExJGcxJHQxNzUxMzgxODY5JGo1OSRsMCRoMA..",
  },
];
---

<Intro text={introText} />
<Cards cards={cards} />
<Outro text={outroText} />
<script >
    import { setupStickyCardsAnimation } from "./stickyCards";
    document.addEventListener("DOMContentLoaded", () => {
        setupStickyCardsAnimation();
    });
</script>